    "No sound events were detected in this session.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectaron eventos de sonido en esta sesión."
          }
        }
      }
    },
    "Not a medical device": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un dispositivo médico"
          }
        }
      }
    },
    "Not enough nights yet. Record a few nights to see your trends.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay suficientes noches. Registra varias noches para ver tus tendencias."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "On the nightstand, 30–60 cm (1–2 ft) from your head, with the microphone (bottom edge) facing you. Keep it plugged into the charger and don’t put it under the pillow.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el buró o mesita, a 30–60 cm de tu cabeza, con el micrófono (borde inferior) hacia ti. Déjalo conectado al cargador y no lo pongas bajo la almohada."
          }
        }
      }
    },
    "Open settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes"
          }
        }
      }
    },
