{
  "sourceLanguage": "en",
  "strings": {
    "%.1f s · peak %lld dB (approx.)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%.1f s · pico %lld dB (aprox.)"
          }
        }
      }
    },
    "%lld dB (approx.)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dB (aprox.)"
          }
        }
      }
    },
    "%lld events · no snoring": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld eventos · sin ronquidos"
          }
        }
      }
    },
    "%lld events · snoring: %lld (%.1f min)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld eventos · ronquido: %lld (%.1f min)"
          }
        }
      }
    },
    "%lld min recorded · %lld events detected": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min registrados · %lld eventos detectados"
          }
        }
      }
    },
    "%lld snoring → long pause → abrupt resumption sequences were observed. This is NOT a diagnosis; if it happens often, talk to a doctor.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se observaron %lld secuencias de ronquido → pausa larga → reanudación brusca. Esto NO es un diagnóstico; si se repite con frecuencia, coméntalo con un médico."
          }
        }
      }
    },
    "+%lld dB above background noise": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld dB sobre el ruido de fondo"
          }
        }
      }
    },
    "Ambient": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambiente"
          }
        }
      }
    },
    "Ambient: %lld · Other: %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambiente: %lld · Otros: %lld"
          }
        }
      }
    },
    "An event is recorded when sound rises above the background noise by this margin. If you sleep somewhere noisy and too many events are recorded, raise it; if soft snores are missed, lower it. Applies from the next session.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un evento se registra cuando el sonido supera el ruido de fondo por este margen. Si duermes en un lugar ruidoso y se registran demasiados eventos, sube el valor; si se pierden ronquidos suaves, bájalo. Aplica a partir de la siguiente sesión."
          }
        }
      }
    },
    "Average duration: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duración promedio: %@"
          }
        }
      }
    },
