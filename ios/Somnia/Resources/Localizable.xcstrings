    "← more sensitive (more events) · less sensitive (loud sounds only) →": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "← más sensible (más eventos) · menos sensible (solo sonidos fuertes) →"
          }
        }
      }
    },
