  "strings": {
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somnia listens while you sleep to detect snoring and other sounds. Audio is processed only on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Somnia escucha mientras duermes para detectar ronquidos y otros sonidos. El audio se procesa solo en tu teléfono."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somnia"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Somnia"
          }
        }
      }
    }
  },
  "version": "1.0"
