    <string name="recommendations_title">Recommendations</string>
    <string name="recommendation_bullet">• %1$s</string>
    <string name="recommendations_disclaimer">General sleep-hygiene suggestions, not a medical diagnosis.</string>
    <string name="tip_pause_pattern">Pauses were observed after snoring. If it keeps happening, talk to a doctor (a sleep study might be worth it).</string>
    <string name="tip_alcohol">You drank alcohol and snored quite a bit: alcohol relaxes the airways and tends to make snoring worse. Try avoiding it before bed.</string>
    <string name="tip_reduce_snoring">You snored quite a bit tonight. Sleeping on your side and keeping a healthy weight usually reduce snoring.</string>
    <string name="tip_late_dinner">You had a late dinner. Eating 2–3 h before bed improves rest and reduces reflux.</string>
    <string name="tip_caffeine">You had caffeine. Avoid it after midday; it can take hours to clear.</string>
    <string name="tip_screen_late">You used screens before bed. Blue light delays sleep; try turning them off 30–60 min earlier.</string>
    <string name="tip_stress">You reported stress. A relaxing routine (breathing, reading) before bed can help.</string>
    <string name="tip_short_sleep">You slept less than 6 h. Aim for a longer sleep window and regular hours.</string>
