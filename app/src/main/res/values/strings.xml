    <!-- Bienvenida -->
    <string name="welcome_title">Welcome to Somnia</string>
    <string name="welcome_intro">Somnia listens while you sleep, detects snoring, coughing, speech and movement, and shows you how your night went. Before you start:</string>
    <string name="welcome_placement_title">📱 Where to put the phone</string>
    <string name="welcome_placement_body">On the nightstand, 30–60 cm (1–2 ft) from your head, with the microphone (bottom edge) facing you. Keep it plugged into the charger and don’t put it under the pillow or between the sheets.</string>
    <string name="welcome_privacy_title">🔒 Your privacy</string>
    <string name="welcome_privacy_body">The whole night isn’t recorded: only short clips of each detected sound. Everything is analyzed and stored on your phone; audio isn’t uploaded to any server or included in backups. It only leaves if you choose to email it.</string>
    <string name="welcome_battery_title">🔋 Keep it running all night</string>
    <string name="welcome_battery_body">Some phones close background apps to save battery. In Somnia’s settings, go to “Battery” and choose “Unrestricted”.</string>
    <string name="welcome_medical_title">⚕️ Not a medical device</string>
    <string name="welcome_medical_body">Somnia guides and documents, but doesn’t diagnose. If you notice breathing pauses or a lot of daytime tiredness, talk to a doctor; you can send them the report from the app.</string>
    <string name="welcome_start">Get started</string>

