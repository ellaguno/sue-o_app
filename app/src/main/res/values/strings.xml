    <string name="settings_title">Settings</string>
    <string name="sensitivity_title">Detection sensitivity</string>
    <string name="sensitivity_help">An event is recorded when sound rises above the background noise by this margin. If you sleep somewhere noisy (busy street, loud fan) and too many events are recorded, raise it; if soft snores are missed, lower it. Applies from the next session.</string>
    <string name="sensitivity_value">+%1$d dB above background noise</string>
    <string name="sensitivity_scale_hint">← more sensitive (more events) · less sensitive (loud sounds only) →</string>
    <string name="sensitivity_floor_note">Constant noise (a fan, the street) is absorbed automatically: the detector adapts its background level.</string>
    <string name="sensitivity_reset">Reset to the recommended value (+%1$d dB)</string>

